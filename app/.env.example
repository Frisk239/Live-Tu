# Server
PORT=3004
NODE_ENV=development

# 仅联调演示时开启：LLM/外部服务失败时允许返回 source:mock 的演示数据
# 生产/真实路径请保持 false 或不设置
ALLOW_MOCK_FALLBACK=false

# 云雾 API（OpenAI 兼容中转）
# 见 docs/云雾.txt
YUNWU_API_KEY=your_yunwu_api_key
YUNWU_BASE_URL=https://api3.wlai.vip/v1
TEXT_MODEL=gpt-4o-mini
GEMINI_API_KEY=

# 视频生成 Provider（二选一）：
#   relay = 星河 Seedance 2.0 中转（默认，账号密码鉴权，见 docs/星河seedance2.0外部接口文档.md）
#   ark   = 火山方舟直连（推荐部署用，Bearer ARK_API_KEY，视频 URL 24h 有效会自动缓存到本地）
SEEDANCE_PROVIDER=relay

# --- relay 模式 ---
SEEDANCE_BASE_URL=https://your-seedance-relay-host
SEEDANCE_ACCOUNT=your_account
SEEDANCE_PASSWORD=your_password

# --- ark 模式（SEEDANCE_PROVIDER=ark）---
ARK_API_KEY=your_ark_api_key
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seedance-2-0-260128

SEEDANCE_MODEL=doubao-seedance-2-0-fast
SEEDANCE_DEFAULT_RESOLUTION=720p
SEEDANCE_DEFAULT_ASPECT=9:16

# 公网站点根（部署后的 https://host:port）。Seedance materials 必须公网可访问；
# 本地 /uploads 路径会拼成 PUBLIC_BASE_URL + path。开发机若无公网 IP，请用 https 外链图做首帧。
PUBLIC_BASE_URL=

# MinIO 自建对象存储（本地 Docker 或 服务器自建）
# 本地 Docker: docker run -d -p 9000:9000 -p 9001:9001 --name minio minio/minio server /data --console-address ":9001"
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=replace-with-dedicated-minio-admin
MINIO_ROOT_PASSWORD=replace-with-a-strong-unique-minio-admin-password
MINIO_ACCESS_KEY=replace-with-live-tu-service-user
MINIO_SECRET_KEY=replace-with-a-strong-unique-service-password
MINIO_BUCKET=buv-materials
MINIO_PUBLIC_URL=
MINIO_ENSURE_PUBLIC_READ=false
# Container-to-MinIO hostname. Use a Compose service name or host.docker.internal.
MINIO_DOCKER_ENDPOINT=host.docker.internal

# Frontend (Vite)
VITE_API_BASE_URL=/api/v1
VITE_HMR_PORT=24679
# Required in production. Use an independent random value with at least 32 characters.
ADMIN_USERNAME=
ADMIN_PASSWORD=
MODEL_KEY_ENCRYPTION_SECRET=
MEDIA_URL_SIGNING_SECRET=
MEDIA_URL_TTL_SECONDS=3600
COOKIE_SECURE=true
# Number of trusted reverse-proxy hops, usually 1 behind Nginx/Traefik.
TRUST_PROXY=1
METRICS_TOKEN=replace-with-a-long-random-monitoring-token
MIN_FREE_STORAGE_BYTES=1073741824
MAX_REMOTE_MEDIA_BYTES=209715200
MAX_REMOTE_IMAGE_BYTES=20971520
BACKUP_DRAIN_TIMEOUT_MS=30000
# Optional absolute root for admin-only server-side media imports.
MATERIAL_IMPORT_ROOT=
EXPENSIVE_REQUESTS_PER_MINUTE=20
MAX_USER_STORAGE_BYTES=5368709120
# Optional comma-separated hostname allowlist for remote media downloads.
REMOTE_MEDIA_HOST_ALLOWLIST=
SHUTDOWN_GRACE_MS=30000
ARTIFACT_RETENTION_DAYS=30
RUN_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365

# Server
PORT=3004
NODE_ENV=development

# 仅联调演示时开启：LLM/外部服务失败时允许返回 source:mock 的演示数据
# 生产/真实路径请保持 false 或不设置
ALLOW_MOCK_FALLBACK=false

# 云雾 API（OpenAI 兼容中转）
# 见 docs/云雾.txt
YUNWU_API_KEY=your_yunwu_api_key
YUNWU_BASE_URL=https://api3.wlai.vip/v1
TEXT_MODEL=gpt-4o-mini
GEMINI_API_KEY=

# 星河 Seedance 2.0 中转方案
# 见 docs/星河seedance2.0外部接口文档.md
# 鉴权：账号密码换短期 USER_TOKEN，不是官方原生 Key
SEEDANCE_BASE_URL=https://your-seedance-relay-host
SEEDANCE_ACCOUNT=your_account
SEEDANCE_PASSWORD=your_password
SEEDANCE_MODEL=doubao-seedance-2-0-fast
SEEDANCE_DEFAULT_RESOLUTION=720p
SEEDANCE_DEFAULT_ASPECT=9:16

# 公网站点根（部署后的 https://host:port）。Seedance materials 必须公网可访问；
# 本地 /uploads 路径会拼成 PUBLIC_BASE_URL + path。开发机若无公网 IP，请用 https 外链图做首帧。
PUBLIC_BASE_URL=

# MinIO 自建对象存储（本地 Docker 或 服务器自建）
# 本地 Docker: docker run -d -p 9000:9000 -p 9001:9001 --name minio minio/minio server /data --console-address ":9001"
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=buv-materials
MINIO_PUBLIC_URL=

# Frontend (Vite)
VITE_API_BASE_URL=/api/v1
VITE_HMR_PORT=24679

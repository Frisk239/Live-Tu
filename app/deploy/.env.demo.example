# Demo URL. Use the server's public IP or a temporary DNS name.
DEMO_PORT=3004
PUBLIC_BASE_URL=http://YOUR_SERVER_IP:3004

# Demo administrator. Change before sharing the URL.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456!
MODEL_KEY_ENCRYPTION_SECRET=replace-with-a-random-32-character-secret
MEDIA_URL_SIGNING_SECRET=replace-with-another-random-32-character-secret
METRICS_TOKEN=replace-with-a-random-metrics-token

# Keep false when real provider keys are configured. True enables UX-only mock fallback.
ALLOW_MOCK_FALLBACK=true
YUNWU_API_KEY=
SEEDANCE_BASE_URL=
SEEDANCE_ACCOUNT=
SEEDANCE_PASSWORD=

# MinIO root credentials are only used by minio-init; the app uses the scoped pair below.
MINIO_ROOT_USER=demo-minio-root
MINIO_ROOT_PASSWORD=replace-with-a-random-minio-root-password
MINIO_ACCESS_KEY=demo-minio-app
MINIO_SECRET_KEY=replace-with-a-random-minio-app-secret
MINIO_BUCKET=buv-materials-demo

# Set COOKIE_SECURE=true and TRUST_PROXY=1 when the demo is behind HTTPS.
COOKIE_SECURE=false
TRUST_PROXY=0

{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx --import ./load-env.ts server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.js",
    "start": "node dist/server.js",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:production": "npm run build && node scripts/test-production-start.mjs",
    "test:orchestrator": "tsx --test server/test/orchestrator.test.ts",
    "test:migrations": "tsx --test server/test/migrations.test.ts",
    "test:permissions": "tsx --test server/test/permissions-api.test.ts",
    "test:multi-shot": "tsx --test server/test/multi-shot.test.ts",
    "test:security": "tsx --test server/test/safe-url.test.ts server/test/safe-url-mapped-ipv6.test.ts server/test/render-storage.test.ts server/test/render-ownership.test.ts server/test/seedance-ownership.test.ts server/test/storage-readiness.test.ts server/test/minio-runtime-contract.test.ts server/test/signed-media.test.ts",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "prune": "node scripts/prune.mjs",
    "test:e2e:smoke": "playwright test e2e/smoke.spec.ts",
    "test:e2e:full": "playwright test e2e/full-pipeline.spec.ts e2e/health-and-apis.spec.ts e2e/step5-readiness.spec.ts",
    "test:e2e:seedance": "node scripts/run-paid-e2e.mjs e2e/seedance-video.spec.ts",
    "test:e2e:durable": "node scripts/run-paid-e2e.mjs e2e/durable-run.spec.ts",
    "test:e2e:paid": "node scripts/run-paid-e2e.mjs e2e/seedance-video.spec.ts e2e/durable-run.spec.ts",
    "test:e2e:all": "playwright test e2e/smoke.spec.ts e2e/step5-readiness.spec.ts e2e/accessibility.spec.ts e2e/permissions.spec.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tailwindcss/vite": "^4.1.14",
    "@types/multer": "^2.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "framer-motion": "^12.42.2",
    "lucide-react": "^0.546.0",
    "minio": "^8.0.7",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
